---
import MainLayout from '../layouts/MainLayout.astro';
import AppBuilder from '../components/AppBuilder.vue';
import apps from '../data/apps.json';
import { validateApps } from '../lib/apps';
import packageJson from '../../package.json';

const appVersion = packageJson.version;
const repoUrl = 'https://github.com/darkniki/initly';
const validatedApps = validateApps(apps);
---

<MainLayout
  title="initly.app - Mac app installer for Homebrew"
  description="Select your Mac apps and generate one Homebrew install command for a fresh setup."
>
  <AppBuilder apps={validatedApps} appVersion={appVersion} repoUrl={repoUrl} client:load />
</MainLayout>
